<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://iptvnator.app/tizen-tv" version="0.1.0" viewmodes="maximized">
    <tizen:application id="IPTVnTVApp.IPTVnator" package="IPTVnTVApp" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>Jo-TV</name>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
    <!-- #85: serves the "add a source from your phone" page while a code is open. -->
    <tizen:service id="IPTVnTVApp.PhoneSource" auto-restart="false" on-boot="false">
        <tizen:content src="service/phone-source.js"/>
        <tizen:name>Jo-TV phone source</tizen:name>
        <tizen:icon src="icon.png"/>
        <tizen:description>Receives a source typed on a phone, on the home network only</tizen:description>
    </tizen:service>
</widget>
