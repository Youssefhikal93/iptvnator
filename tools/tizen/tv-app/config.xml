<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://iptvnator.app/tizen-tv" version="0.1.0" viewmodes="maximized">
    <tizen:application id="IPTVnTVApp.IPTVnator" package="IPTVnTVApp" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>Jotv</name>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.audio"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
    <!-- #85: serves the "add a source from your phone" page while a code is open. -->
    <tizen:service id="IPTVnTVApp.PhoneSource" auto-restart="false" on-boot="false">
        <tizen:content src="service/phone-source.js"/>
        <tizen:name>Jotv phone source</tizen:name>
        <tizen:icon src="icon.png"/>
        <tizen:description>Receives a source typed on a phone, on the home network only</tizen:description>
    </tizen:service>
    <tizen:service id="IPTVnTVApp.PhoneRemote" auto-restart="false" on-boot="false">
        <tizen:content src="service/phone-remote.js"/>
        <tizen:name>Jotv phone remote</tizen:name>
        <tizen:icon src="icon.png"/>
        <tizen:description>Phone remote on the home network while Jotv is open</tizen:description>
    </tizen:service>
    <!-- #91: Jotv tiles on the Samsung home screen; a picked tile opens the running app without reloading it. -->
    <tizen:app-control>
        <tizen:src name="index.html" reload="disable"/>
        <tizen:operation name="http://samsung.com/appcontrol/operation/eden_resume"/>
    </tizen:app-control>
    <tizen:service id="IPTVnTVApp.HubPreview" auto-restart="false" on-boot="false">
        <tizen:content src="service/hub-preview.js"/>
        <tizen:name>Jotv home tiles</tizen:name>
        <tizen:icon src="icon.png"/>
        <tizen:description>Puts Continue watching and Recent channels on the Samsung home screen</tizen:description>
        <tizen:category name="http://tizen.org/category/service"/>
    </tizen:service>
    <tizen:metadata key="http://samsung.com/tv/metadata/use.preview" value="bg_service"/>
</widget>
