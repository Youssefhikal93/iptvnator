<?xml version="1.0" encoding="UTF-8"?>
<!-- IPTVnator for Samsung TV. Own id and package: installs next to Jo-TV. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://iptvnator.app/tizen-iptvnator" version="{{version}}" viewmodes="maximized">
    <tizen:application id="IPTVnSamTV.IPTVnator" package="IPTVnSamTV" required_version="7.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>IPTVnator</name>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <!-- Providers are reached directly (phase 1 direct data), so any origin is allowed. -->
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
